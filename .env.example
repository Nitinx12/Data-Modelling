# ============================================================
# .env.example — template for the real .env (never commit .env)
# ============================================================
# Copy to .env and fill in values: cp .env.example .env
# Required and optional variables mirror utils/engine.py exactly.
# CI usage: docs/CI_CD.md §4.3 writes this file's CI equivalent.
# ============================================================

# --- PostgreSQL warehouse (all required) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DATABASE=data_warehouse
POSTGRES_USERNAME=
POSTGRES_PASSWORD=

# --- PostgreSQL connection tuning (optional) ---
POSTGRES_SSLMODE=
POSTGRES_CHANNEL_BINDING=

# --- Schema name overrides (optional) ---
POSTGRES_SCHEMA_BRONZE=
POSTGRES_SCHEMA_SILVER=
POSTGRES_SCHEMA_GOLD=

# --- MongoDB source (required) ---
MONGO_URI=mongodb://localhost:27017
MONGO_DB=

# --- PySpark (optional) ---
PYSPARK_PYTHON=
PYSPARK_DRIVER_PYTHON=

# --- Databricks (optional — only needed for get_databricks_connection) ---
DATABRICKS_HOST=
DATABRICKS_HTTP_PATH=
DATABRICKS_TOKEN=
DATABRICKS_CATALOG=
DATABRICKS_SCHEMA=
